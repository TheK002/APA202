@using _27_FrontToBackSqlConnection.Areas.AdminPanel.ViewModels.Product
@model List<ProductGetVM>

@{
    int count = 0;
}


<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Create Product</h4>
                <div class="table-responsive pt-3">
                    <a asp-area="AdminPanel" asp-controller="Category" asp-action="Create" class="btn btn-success btn-rounded btn-fw">Create</a>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>
                                    #
                                </th>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Price
                                </th>
                                <th>
                                    SKU
                                </th>
                                <th>
                                    Tag
                                </th>
                                <th>
                                    Category
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ProductGetVM productGetVM in Model)
                            {
                                <tr class="table-info">
                                    <td>
                                        <p>@(++count)</p>
                                    </td>
                                    <td>
                                        <p>@productGetVM.Image</p>
                                    </td>

                                    <td>
                                        <p>@productGetVM.Name</p>
                                    </td>
                                    <td>
                                        <p>@productGetVM.Price</p>
                                    </td>
                                    <td>
                                        <p>@productGetVM.SKU</p>
                                    </td>
                                    <td>
                                        <p>@productGetVM.</p>
                                    </td>
                                    @* <td>
                                        <a asp-action="update" asp-route-id="@category.Id" class="btn btn-warning btn-rounded btn-fw">Edit</a>
                                        <a asp-action="delete" asp-route-id="@category.Id" class="btn btn-danger btn-rounded btn-fw">Delete</a>
                                        <a asp-action="Detail" asp-route-id="@category.Id" class="btn btn-info btn-rounded btn-fw">Detail</a>
                                    </td> *@

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
